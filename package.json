{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{app,components,data,helpers,hooks,lib,types,tests}/**/*.{js,jsx,ts,tsx}\" eslint.config.mjs next.config.js postcss.config.js vitest.config.mts",
    "format:check": "prettier --check \"{app,components,data,helpers,hooks,lib,types,tests}/**/*.{js,jsx,ts,tsx}\" eslint.config.mjs next.config.js postcss.config.js vitest.config.mts",
    "doctor": "npx -y react-doctor --verbose"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-toastify": "^11.2.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-doctor": "^0.9.23",
    "jsdom": "^31.0.1",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
